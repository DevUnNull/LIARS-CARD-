{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PenaltyAnimation": {
    "AckTimeoutSeconds": 30
  },
  "MongoDbContext": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "LiarDB"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "Issuer": "LiarCardServer",
    "Audience": "LiarCardClient",
    "ExpiryMinutes": 30,
    "RefreshTokenDays": 30
  }
}
