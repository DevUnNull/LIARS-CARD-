# Copy thành server.env (đã gitignore) rồi điền giá trị thật.
MongoDbContext__ConnectionString=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MongoDbContext__DatabaseName=LiarDB
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: openssl rand -base64 48
Jwt__Key=THAY_BANG_CHUOI_NGAU_NHIEN
